#!/bin/sh

set -u

root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1

echo "pre-push: cargo clippy --workspace --all-targets --all-features -- -D warnings"

if cargo clippy --workspace --all-targets --all-features -j 2 -- -D warnings; then
	exit 0
fi

cat >&2 <<'MSG'

pre-push: clippy fails. CI runs the same command as its first gate and will
fail on this. Remember the funnels in clippy.toml: subprocesses go through
relift_proc::command and file writes through relift_cache.

Genuinely need to push first? "git push --no-verify" skips this hook.
MSG
exit 1
