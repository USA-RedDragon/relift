#version 450
/**
 * @file smaa_edges.comp
 * @brief SMAA's first pass: luma edge detection, color_in to edges.
 */
#include "smaa.glsl"

void main()
{
    ivec2 p;
    if (!this_pixel(p))
        return;
    vec2 uv = center_uv(p);
    vec4 offset[3];
    SMAAEdgeDetectionVS(uv, offset);
    vec2 e = SMAALumaEdgeDetectionPS(uv, offset, TEX_COLOR);
    edges[p.y * pc.size.x + p.x] = packUnorm4x8(vec4(e, 0.0, 0.0));
}
