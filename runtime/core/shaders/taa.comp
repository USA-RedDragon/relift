#version 450
/**
 * @file taa.comp
 * @brief relift's plain temporal upscaler (taa.c), written for relift: each display pixel blends a reconstruction
 * of this frame's jittered render pixels around it with the history reprojected by the motion vectors, the history
 * clamped to the variance of the pixels around it in YCoCg. HDR color blends tonemapped. The jitter and motion
 * vectors follow the DLSS and FSR convention: a render pixel's center shows the picture at the center minus the
 * jitter, and a motion vector times its scale points from a pixel to where it was the frame before.
 */
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform texture2D color_img;
layout(binding = 1) uniform texture2D depth_img;
layout(binding = 2) uniform texture2D motion_img;
layout(binding = 3) uniform texture2D history_img;
layout(binding = 4, rgba16f) uniform writeonly image2D history_out;
layout(binding = 5) uniform writeonly image2D out_img;
layout(binding = 6) uniform sampler linear_clamp;

/**
 * @brief Render and display sizes, the jitter in render pixels, the motion vectors' scale to UV and the jitter they
 * carry in UV, and flags: bit 0 reset, bit 1 HDR, bit 2 inverted depth, bit 3 motion vectors at display size.
 */
layout(binding = 7, std140) uniform Params {
    ivec2 render;
    ivec2 display;
    vec2 jitter;
    vec2 motion_scale;
    vec2 motion_jitter;
    float min_alpha;
    float variance_gamma;
    int flags;
} pc;

const int RESET = 1;
const int HDR = 2;
const int INVERTED = 4;
const int MOTION_DISPLAY = 8;

vec3 to_ycocg(vec3 c)
{
    return vec3(0.25 * c.r + 0.5 * c.g + 0.25 * c.b, 0.5 * c.r - 0.5 * c.b, -0.25 * c.r + 0.5 * c.g - 0.25 * c.b);
}

vec3 from_ycocg(vec3 c) { return vec3(c.x + c.y - c.z, c.x + c.z, c.x - c.y - c.z); }

/** @brief Color as blended: tonemapped by luma for HDR (Karis), unchanged for SDR. */
vec3 to_blend(vec3 c)
{
    if ((pc.flags & HDR) == 0)
        return c;
    return c / (1.0 + max(max(c.r, c.g), c.b));
}

vec3 from_blend(vec3 c)
{
    if ((pc.flags & HDR) == 0)
        return c;
    return c / max(1.0 - max(max(c.r, c.g), c.b), 1.0 / 65504.0);
}

/** @brief The history at uv, Catmull-Rom with nine bilinear taps reduced to five. */
vec3 history_at(vec2 uv)
{
    vec2 size = vec2(pc.display);
    vec2 pos = uv * size;
    vec2 center = floor(pos - 0.5) + 0.5;
    vec2 f = pos - center;
    vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    vec2 w3 = f * f * (-0.5 + 0.5 * f);
    vec2 w12 = w1 + w2;
    vec2 t0 = (center - 1.0) / size;
    vec2 t3 = (center + 2.0) / size;
    vec2 t12 = (center + w2 / w12) / size;
    vec3 c = vec3(0.0);
    c += textureLod(sampler2D(history_img, linear_clamp), vec2(t12.x, t0.y), 0.0).rgb * (w12.x * w0.y);
    c += textureLod(sampler2D(history_img, linear_clamp), vec2(t0.x, t12.y), 0.0).rgb * (w0.x * w12.y);
    c += textureLod(sampler2D(history_img, linear_clamp), vec2(t12.x, t12.y), 0.0).rgb * (w12.x * w12.y);
    c += textureLod(sampler2D(history_img, linear_clamp), vec2(t3.x, t12.y), 0.0).rgb * (w3.x * w12.y);
    c += textureLod(sampler2D(history_img, linear_clamp), vec2(t12.x, t3.y), 0.0).rgb * (w12.x * w3.y);
    float sum = w12.x * w0.y + w0.x * w12.y + w12.x * w12.y + w3.x * w12.y + w12.x * w3.y;
    return max(c / sum, vec3(0.0));
}

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, pc.display)))
        return;
    vec2 uv = (vec2(p) + 0.5) / vec2(pc.display);
    vec2 scale = vec2(pc.render) / vec2(pc.display);
    vec2 s = uv * vec2(pc.render);
    ivec2 base = ivec2(floor(s + pc.jitter));
    vec3 sum = vec3(0.0), m1 = vec3(0.0), m2 = vec3(0.0);
    float wsum = 0.0, wmax = 0.0;
    float best_depth = (pc.flags & INVERTED) != 0 ? -1.0 : 2.0;
    ivec2 best = base;
    for (int dy = -1; dy <= 1; dy++)
        for (int dx = -1; dx <= 1; dx++) {
            ivec2 q = clamp(base + ivec2(dx, dy), ivec2(0), pc.render - 1);
            vec3 c = to_blend(texelFetch(color_img, q, 0).rgb);
            vec2 d = (vec2(q) + 0.5 - pc.jitter - s) / scale;
            float w = exp(-2.29 * dot(d, d));
            sum += c * w;
            wsum += w;
            wmax = max(wmax, w);
            vec3 y = to_ycocg(c);
            m1 += y;
            m2 += y * y;
            float z = texelFetch(depth_img, q, 0).r;
            bool nearer = (pc.flags & INVERTED) != 0 ? z > best_depth : z < best_depth;
            if (nearer) {
                best_depth = z;
                best = q;
            }
        }
    vec3 current = sum / max(wsum, 1e-6);
    vec2 mv_px = (pc.flags & MOTION_DISPLAY) != 0 ? (vec2(best) + 0.5) / scale : vec2(best);
    vec2 mv = texelFetch(motion_img, ivec2(mv_px), 0).xy * pc.motion_scale - pc.motion_jitter;
    vec2 prev = uv + mv;
    vec3 result = current;
    float frames = 1.0;
    bool inside = all(greaterThanEqual(prev, vec2(0.0))) && all(lessThanEqual(prev, vec2(1.0)));
    if ((pc.flags & RESET) == 0 && inside) {
        vec4 h = textureLod(sampler2D(history_img, linear_clamp), prev, 0.0);
        vec3 hist = history_at(prev);
        vec3 mean = m1 / 9.0;
        vec3 sigma = sqrt(max(m2 / 9.0 - mean * mean, vec3(0.0)));
        vec3 lo = mean - pc.variance_gamma * sigma, hi = mean + pc.variance_gamma * sigma;
        vec3 clamped = from_ycocg(clamp(to_ycocg(hist), lo, hi));
        frames = min(h.a * 255.0 + 1.0, 255.0);
        float alpha = max(1.0 / frames, pc.min_alpha) * clamp(wmax * 1.5, 0.2, 1.0);
        result = mix(clamped, current, alpha);
    }
    imageStore(history_out, p, vec4(result, frames / 255.0));
    imageStore(out_img, p, vec4(from_blend(result), 1.0));
}
