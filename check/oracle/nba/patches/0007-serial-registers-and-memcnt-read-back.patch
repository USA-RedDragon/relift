-    case RCNT+1: return rcnt[1];
+    case RCNT+0: {
+      if(!(rcnt[1] & 0x80)) return 0x05;
+      const u8 dir = rcnt[0] >> 4;
+      return (rcnt[0] & 0xF0) | (rcnt[0] & dir) | (0x0F & ~dir);
+    }
+    case RCNT+1: return rcnt[1] & 0xC0;
     case RCNT+2:
     case RCNT+3: return 0;
+    case JOYCNT+0: return 0;
+    case JOYCNT+1: return 0;
+    case JOYSTAT+0: return sio_plain[JOYSTAT & 0x3F] | 0x08;
+    case JOYSTAT+1: return 0;
+    case MEMCNT+0: return (u8)(memcnt >> 0);
+    case MEMCNT+1: return (u8)(memcnt >> 8);
+    case MEMCNT+2: return (u8)(memcnt >> 16);
+    case MEMCNT+3: return (u8)(memcnt >> 24);
+    case SIOMULTI0 ... SIOMULTI3+1: return 0;
+    case SIODATA8 ... SIODATA8+1:
+    case JOY_RECV ... JOY_TRANS+3: return sio_plain[address & 0x3F];
