     case 0x0400015A:
@@ -509,6 +524,14 @@ void Bus::Hardware::WriteByte(u32 address,  u8 value) {
     case SIOCNT+1: WriteHalf(SIOCNT, (siocnt & 0x00FF) | (value << 8)); break;
     case RCNT+0: rcnt[0] = value; break;
     case RCNT+1: rcnt[1] = value; break;
+    case SIOMULTI0 ... SIOMULTI3+1: break;
+    case SIODATA8 ... SIODATA8+1:
+    case JOY_RECV ... JOY_TRANS+3: sio_plain[address & 0x3F] = value; break;
+    case JOYSTAT+0: sio_plain[JOYSTAT & 0x3F] = value & 0x30; break;
+    case MEMCNT+0: memcnt = (memcnt & 0xFFFFFF00u) | (u32(value) << 0); break;
+    case MEMCNT+1: memcnt = (memcnt & 0xFFFF00FFu) | (u32(value) << 8); break;
+    case MEMCNT+2: memcnt = (memcnt & 0xFF00FFFFu) | (u32(value) << 16); break;
+    case MEMCNT+3: memcnt = (memcnt & 0x00FFFFFFu) | (u32(value) << 24); break;
 
     // Keypad
     case KEYCNT:   keypad.control.WriteByte(0, value); break;
