+  auto oracleOffset(n16 address) -> s64 override {
+    if(address <= 0x3fff) return (romBank[0] << 14 | (n14)address) & rom.mask();
+    if(address <= 0x7fff) return (romBank[1] << 14 | (n14)address) & rom.mask();
+    if(address <= 0x9fff) return (romBank[2] << 14 | (n14)address) & rom.mask();
+    if(address <= 0xbfff) {
+      if(ram && ramEnable) return -1;
+      return (romBank[2] << 14 | (n14)address) & rom.mask();
+    }
+    return -3;
+  }
+  auto oracleIsMapperReg(n16 address) -> bool override { return address == 0x0000 || address == 0x4000 || address == 0x8000; }
+  auto oracleBanks() -> string override {
+    return {"b0=", hex(romBank[0], 2L), " b1=", hex(romBank[1], 2L), " b2=", hex(romBank[2], 2L), " ram=", ramEnable};
+  }
+
   auto power() -> void override {
     romBank[0] = 0;
     romBank[1] = 1;
