+  auto oracleOffset(n16 address) -> s64 override {
+    if(address <= 0x03ff) return address & rom.mask();
+    if(address <= 0x3fff) return (romBankUpper << 17 | romBank0 << 14 | (n14)address) & rom.mask();
+    if(address <= 0x7fff) return (romBankUpper << 17 | romBank1 << 14 | (n14)address) & rom.mask();
+    if(address <= 0xbfff) {
+      if(ram && ramEnableBank2) return -1;
+      return (romBankUpper << 17 | romBank2 << 14 | (n14)address) & rom.mask();
+    }
+    if(ram && ramEnableBank3) return -1;
+    return -3;
+  }
+  auto oracleIsMapperReg(n16 address) -> bool override { return address >= 0xfffc; }
+  auto oracleBanks() -> string override {
+    return {"b0=", hex(romBank0, 2L), " b1=", hex(romBank1, 2L), " b2=", hex(romBank2, 2L),
+            " upper=", romBankUpper, " ram2=", ramEnableBank2, " ram3=", ramEnableBank3, " ramsel=", ramBank2, " romwr=", romWriteEnable};
+  }
+
