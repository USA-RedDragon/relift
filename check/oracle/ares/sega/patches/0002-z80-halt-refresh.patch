--- a/ares/component/processor/z80/instruction.cpp
+++ b/ares/component/processor/z80/instruction.cpp
@@ -3,7 +3,8 @@
   P = 0;
 
   if(HALT) {
-    return wait(1);
+    R.bit(0,6)++;
+    return wait(4);
   }
   if(oracleHooks.z80Insn) oracleHooks.z80Insn(this, PC);
 
