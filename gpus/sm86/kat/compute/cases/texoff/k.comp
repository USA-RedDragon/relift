#version 460
#extension GL_EXT_buffer_reference : require
layout(local_size_x = 64) in;
layout(buffer_reference, std430) buffer Words { vec4 d[]; };
layout(push_constant) uniform Bank { Words a; Words o; };
layout(set = 2, binding = 0) uniform sampler smp[4];
layout(set = 2, binding = 2) uniform texture2D tex[4];
#define S sampler2D(tex[1], smp[0])
void main() {
    uint g = gl_GlobalInvocationID.x;
    vec4 c = a.d[g];
    vec4 acc = vec4(0.0);
    vec3 t0 = textureLodOffset(S, c.wz, 0.0, ivec2(-1, -5)).xzw;
    acc = acc * 2.0 + vec4(t0, 1.0);
    vec3 t1 = textureLodOffset(S, c.xy, 0.0, ivec2(-8, -8)).xyz;
    acc = acc * 3.0 + vec4(t1, 1.0);
    float t2 = textureLodOffset(S, c.xy, 0.0, ivec2(-2, 5)).x;
    acc = acc * 4.0 + vec4(t2);
    vec4 t3 = textureLodOffset(S, c.xz, 0.0, ivec2(-1, 6)).xyzw;
    acc = acc * 5.0 + t3;
    vec4 t4 = textureLodOffset(S, c.zy, 0.0, ivec2(-1, 3)).xyzw;
    acc = acc * 6.0 + t4;
    o.d[g] = acc;
}
