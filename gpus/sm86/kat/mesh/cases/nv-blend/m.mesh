#version 460
#extension GL_NV_mesh_shader : require
layout(local_size_x = 32) in;
layout(triangles, max_vertices = 64, max_primitives = 64) out;
taskNV in Task { uint a[8]; } t;
layout(location = 0) out vec4 o[];
void main() {
    uint i = gl_LocalInvocationID.x;
    uint w = gl_WorkGroupID.x;
    for (uint v = i; v < 64; v += 32) {
        float s = float(v % 8) / 4.0 - 1.0, r = float(v / 8) / 4.0 - 1.0;
        gl_MeshVerticesNV[v].gl_Position = vec4(s + float(t.a[w % 8u] & 7u) * 0.05, r + float(w) * 0.02, 0.5, 1.0);
        o[v] = vec4(float(v) / 64.0, float(w) / 8.0, float(t.a[1] & 255u) / 256.0, 0.5);
    }
    for (uint p = i; p < 64; p += 32) {
        gl_PrimitiveIndicesNV[3 * p] = p % 56u;
        gl_PrimitiveIndicesNV[3 * p + 1] = p % 56u + 9u;
        gl_PrimitiveIndicesNV[3 * p + 2] = (p * 5u) % 64u;
    }
    if (i == 0) gl_PrimitiveCountNV = 64 - 5 * w;
}
