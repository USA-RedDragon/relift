#version 460
#extension GL_NV_mesh_shader : require
layout(local_size_x = 32) in;
layout(triangles, max_vertices = 64, max_primitives = 42) out;
taskNV in Task { uint a[32]; } t;
layout(location = 0) out vec4 o[];
layout(location = 1) out vec2 o2[];
void main() {
    uint i = gl_LocalInvocationID.x;
    uint w = gl_WorkGroupID.x;
    for (uint v = i; v < 64; v += 32) {
        gl_MeshVerticesNV[v].gl_Position = vec4(float(v % 8) / 4.0 - 1.0, float(v / 8) / 4.0 - 1.0 + float(w) * 0.01, 0.5, 1.0);
        o[v] = vec4(float(t.a[v & 31]), float(w), float(v), 1.0);
        o2[v] = vec2(float(t.a[(v * 5u) & 31u]), 2.0);
    }
    for (uint p = i; p < 42; p += 32) {
        gl_PrimitiveIndicesNV[3 * p] = p;
        gl_PrimitiveIndicesNV[3 * p + 1] = p + 1;
        gl_PrimitiveIndicesNV[3 * p + 2] = p + 8;
    }
    if (i == 0) gl_PrimitiveCountNV = 40 - w;
}
