#version 450
#extension GL_EXT_nonuniform_qualifier : require
layout(local_size_x = 4, local_size_y = 2) in;
layout(set = 2, binding = 2) uniform texture2D tex[];
layout(set = 2, binding = 0) uniform sampler smp[];
layout(set = 2, binding = 35) writeonly uniform image2D img[];
layout(set = 0, binding = 0) buffer B { uint n[]; } b;
void main() {
    ivec2 p = ivec2(gl_LocalInvocationID.xy);
    vec4 t = texelFetch(sampler2D(tex[1], smp[0]), p, 0);
    imageStore(img[3], p, t.bgra);
    imageStore(img[3], ivec2(p.x + 100, p.y), t);
    if (p.x == 0 && p.y == 0) {
        ivec2 s = textureSize(sampler2D(tex[1], smp[0]), 1);
        b.n[0] = uint(s.x);
        b.n[1] = uint(s.y);
        b.n[2] = uint(b.n.length());
        b.n[3] = uint(textureQueryLevels(sampler2D(tex[1], smp[0])));
        b.n[4] = floatBitsToUint(texelFetch(sampler2D(tex[1], smp[0]), ivec2(9, 0), 0).x);
    }
}
