#version 450
#extension GL_KHR_shader_subgroup_basic : require
layout(local_size_x = 64) in;
shared uint s[64];
layout(set = 0, binding = 0) buffer B { uint o[]; } b;
void main() {
    uint i = gl_LocalInvocationIndex;
    if (i >= 32u)
        return;
    s[i] = i * 7u + 1u;
    subgroupBarrier();
    b.o[i] = s[i ^ 1u];
}
